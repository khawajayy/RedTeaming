rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles & roadmap milestone subcollection
    // Ensures only the authenticated user can read, create, update, or delete their roadmap data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /roadmap/{milestoneId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Direct collection fallback (if using top-level /roadmap with userId field)
    match /roadmap/{milestoneId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
